<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView android:id="@+id/widget_previous" android:layout_width="44dp" android:layout_height="44dp"
        android:padding="10dp" android:src="@drawable/widget_previous" android:contentDescription="Previous" />
    <ImageView android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp"
        android:padding="8dp" android:src="@drawable/widget_play" android:contentDescription="Play or pause" />
    <ImageView android:id="@+id/widget_next" android:layout_width="44dp" android:layout_height="44dp"
        android:padding="10dp" android:src="@drawable/widget_next" android:contentDescription="Next" />
</LinearLayout>
